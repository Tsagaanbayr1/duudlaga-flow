<Window x:Class="DuudlagaFlow.Views.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duudlaga Flow - Тохируулга"
        Width="520" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Progress -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="StepLabel" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <ProgressBar x:Name="StepProgress" Height="4" Minimum="0" Maximum="3"
                         Foreground="{StaticResource PrimaryBrush}"/>
        </StackPanel>

        <!-- Step content -->
        <Grid Grid.Row="1">
            <!-- Step 0: Welcome -->
            <StackPanel x:Name="WelcomeStep" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Duudlaga Flow" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Монгол хэлний ярианы бичвэр хөрвүүлэгч"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <StackPanel Margin="20,0">
                    <TextBlock Margin="0,4" FontSize="13">
                        <Run FontWeight="SemiBold">Ctrl+Alt</Run>
                        <Run> дарж ярина - текст автоматаар бичигдэнэ</Run>
                    </TextBlock>
                    <TextBlock Margin="0,4" FontSize="13">
                        <Run FontWeight="SemiBold">Chimege API</Run>
                        <Run> ашиглан Монгол хэлийг таньна</Run>
                    </TextBlock>
                    <TextBlock Margin="0,4" FontSize="13">
                        <Run FontWeight="SemiBold">Аль ч апп</Run>
                        <Run> дээр шууд текст оруулна</Run>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Step 1: API Token -->
            <StackPanel x:Name="TokenStep" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="API Token тохируулах" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16">
                    console.chimege.com хаягаас бүртгүүлж token авна уу
                </TextBlock>

                <TextBlock Text="API Token" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="OnboardTokenBox" MaxLength="200" Padding="8,6"/>
                <TextBlock x:Name="OnboardTokenStatus" Margin="0,4,0,0" FontSize="11"/>

                <Button Content="Token шалгах" Margin="0,12,0,0"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center"
                        Click="OnTestOnboardToken"/>

                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Hyperlink Click="OnOpenConsole">
                        Chimege Console нээх
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Step 2: Microphone -->
            <StackPanel x:Name="MicStep" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Микрофон тохируулах" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Бичлэгт ашиглах микрофоноо сонгоно уу"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock Text="Микрофон" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="OnboardMicCombo" Padding="8,6" Margin="0,0,0,12"/>

                <Button Content="Микрофон шалгах" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center" Click="OnTestOnboardMic" x:Name="OnboardMicTestBtn"/>
                <ProgressBar x:Name="OnboardMicLevel" Height="16" Margin="0,8,0,0"
                             Minimum="0" Maximum="1"/>
                <TextBlock x:Name="OnboardMicStatus" Margin="0,4,0,0" FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Step 3: Complete -->
            <StackPanel x:Name="CompleteStep" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#x2705;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Бэлэн боллоо!" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                    Ctrl+Alt дарж ярьж эхэлнэ үү.
                    Текст таны идэвхтэй апп дээр автоматаар бичигдэнэ.
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Content="Буцах"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    Click="OnBackClick" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Grid.Column="1" Content="Дараах"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Click="OnNextClick"/>
        </Grid>
    </Grid>
</Window>
