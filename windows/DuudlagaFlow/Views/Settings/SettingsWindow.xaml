<Window x:Class="DuudlagaFlow.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:DuudlagaFlow.Views.Settings"
        Title="Duudlaga Flow - Тохиргоо"
        Width="500" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <TabControl Margin="8">
        <TabItem Header="Ерөнхий">
            <settings:GeneralSettingsPage/>
        </TabItem>
        <TabItem Header="Товчлуур">
            <settings:HotkeySettingsPage/>
        </TabItem>
        <TabItem Header="Аудио">
            <settings:AudioSettingsPage/>
        </TabItem>
    </TabControl>
</Window>
