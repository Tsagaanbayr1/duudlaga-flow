<Window x:Class="DuudlagaFlow.Views.FlowBar.FlowBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DuudlagaFlow.Views.FlowBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="120" Height="28"
        Focusable="False"
        Title="DuudlagaFlow FlowBar">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Тохиргоо..." Click="OnSettingsClick"/>
            <Separator/>
            <MenuItem Header="Гарах" Click="OnQuitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- Idle state: small capsule -->
        <Border x:Name="IdleBorder"
                CornerRadius="3"
                Height="6" Width="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Visible">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4B5563" Offset="0"/>
                    <GradientStop Color="#6B7280" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Opacity="0.3" ShadowDepth="1"/>
            </Border.Effect>
        </Border>

        <!-- Recording state: expanded with waveform -->
        <Border x:Name="RecordingBorder"
                CornerRadius="14"
                Height="28" Width="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DC2626" Offset="0"/>
                    <GradientStop Color="#EF4444" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="#DC2626"/>
            </Border.Effect>
            <Grid>
                <local:WaveformControl x:Name="Waveform"
                                        DotColor="White"
                                        DotCount="5"
                                        Margin="20,4"/>
            </Grid>
        </Border>

        <!-- Processing state -->
        <Border x:Name="ProcessingBorder"
                CornerRadius="14"
                Height="28" Width="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="#2563EB"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Боловсруулж байна..."
                           Foreground="White"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Success state -->
        <Border x:Name="SuccessBorder"
                CornerRadius="3"
                Height="6" Width="120"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#16A34A" Offset="0"/>
                    <GradientStop Color="#22C55E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Opacity="0.3" ShadowDepth="1"/>
            </Border.Effect>
        </Border>

        <!-- Error state -->
        <Border x:Name="ErrorBorder"
                CornerRadius="12"
                Height="24" Width="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DC2626" Offset="0"/>
                    <GradientStop Color="#EF4444" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.3" ShadowDepth="1"/>
            </Border.Effect>
            <TextBlock x:Name="ErrorText"
                       Foreground="White"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="12,0"/>
        </Border>
    </Grid>
</Window>
